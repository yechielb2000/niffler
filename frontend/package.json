{
  "name": "niffler-frontend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src vite.config.ts --max-warnings=0",
    "lint:fix": "eslint src vite.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" vite.config.ts eslint.config.mjs .prettierrc.json package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" vite.config.ts eslint.config.mjs .prettierrc.json package.json"
  },
  "dependencies": {
    "@emotion/react": "^11.11.11",
    "@emotion/styled": "^11.11.11",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@mui/icons-material": "^5.16.0",
    "@mui/material": "^5.16.0",
    "@types/leaflet": "^1.9.21",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.21.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^5.4.10"
  }
}
